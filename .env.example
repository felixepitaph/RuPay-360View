# Copy to .env and fill in. Never commit .env. In AiNxt, put these in Profile > API Token Vault.
# Use a READ-ONLY Trino service account.

TRINO_HOST=your-trino-host.internal
TRINO_PORT=443
TRINO_HTTP_SCHEME=https
TRINO_USER=r360-readonly
# Preferred: JWT / API token (what AiNxt asked for). Otherwise password.
TRINO_JWT=
TRINO_PASSWORD=
TRINO_CATALOG=
TRINO_SCHEMA=
TRINO_CA_BUNDLE=

# Engines and tools
# trino  |  local:demo/data (synthetic)  |  local:<snapshot folder>
R360_SOURCE=local:demo/data
# extra catalog folders, separated by ':' (e.g. catalog:demo/catalog for the demo)
R360_CATALOG_DIRS=
R360_MAX_ROWS=50000
# Encrypted/tokenised user id columns the model may see (comma list), e.g. user_ref,card_token. Leave empty until the data team confirms the column is encrypted.
R360_ALLOWED_ID_COLUMNS=
R360_QUERY_LOG=runs/query_log.jsonl
# Bearer token that AiNxt sends to tools/server.py
R360_TOOL_TOKEN=
R360_TOOL_HOST=127.0.0.1
R360_TOOL_PORT=8360
