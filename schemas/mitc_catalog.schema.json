{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MITC catalog: one file per issuer MITC document (v2, tested against YES and IDFC FIRST MITCs)",
  "description": "Real MITCs are issuer-wide documents with variant-keyed tables, not one document per card. Rules that vary by variant list the variants they apply to. Values not stated in the document stay null.",
  "type": "object",
  "required": ["issuer_bank", "document", "sources", "variants", "finance_charges", "forex", "category_fees"],
  "additionalProperties": false,
  "definitions": {
    "source": {
      "type": "object",
      "required": ["document", "locator", "retrieved_on"],
      "properties": {
        "document": { "type": "string" },
        "locator": { "type": "string", "description": "Section or page" },
        "retrieved_on": { "type": "string", "format": "date" }
      }
    },
    "variant_list": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "money": { "type": ["number", "null"] }
  },
  "properties": {
    "issuer_bank": { "type": "string" },
    "document": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "document_date": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variant"],
        "properties": {
          "variant": { "type": "string" },
          "network_hint": { "enum": ["RUPAY", "VISA", "MASTERCARD", "NOT_STATED"] },
          "is_upi_credit_card": { "type": "boolean" },
          "joining_fee_inr": { "$ref": "#/definitions/money" },
          "annual_fee_inr": { "$ref": "#/definitions/money" },
          "joining_fee_waiver_spend_inr": { "$ref": "#/definitions/money" },
          "annual_fee_waiver_spend_inr": { "$ref": "#/definitions/money" },
          "addon_fee_inr": { "$ref": "#/definitions/money" },
          "notes": { "type": "string" }
        }
      }
    },
    "finance_charges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variants"],
        "properties": {
          "variants": { "$ref": "#/definitions/variant_list" },
          "monthly_pct": { "type": ["number", "null"] },
          "annual_pct": { "type": ["number", "null"] },
          "range_note": { "type": "string" }
        }
      }
    },
    "forex": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variants"],
        "properties": {
          "variants": { "$ref": "#/definitions/variant_list" },
          "forex_markup_pct": { "type": ["number", "null"] },
          "forex_markup_pct_before_change": { "type": ["number", "null"] },
          "change_effective": { "type": ["string", "null"] },
          "dcc_markup_pct": { "type": ["number", "null"] },
          "notes": { "type": "string" }
        }
      }
    },
    "general_fees": {
      "type": "array",
      "description": "Cash advance, late payment, overlimit, returns, redemption, cash deposit, replacement and similar",
      "items": {
        "type": "object",
        "required": ["fee", "rule"],
        "properties": {
          "fee": { "type": "string" },
          "rule": { "type": "string", "description": "Exact rule in plain words with numbers" },
          "pct": { "type": ["number", "null"] },
          "min_inr": { "type": ["number", "null"] },
          "max_inr": { "type": ["number", "null"] },
          "flat_inr": { "type": ["number", "null"] },
          "effective_from": { "type": ["string", "null"] },
          "waived_for": { "type": "array", "items": { "type": "string" } },
          "locator": { "type": "string" }
        }
      }
    },
    "category_fees": {
      "type": "array",
      "description": "Surcharges on spend categories (rent, wallet, education, utility, fuel, tolls, railways). Thresholds may vary by variant.",
      "items": {
        "type": "object",
        "required": ["category", "fee_pct", "mccs"],
        "properties": {
          "category": { "type": "string" },
          "mccs": { "type": "array", "items": { "type": "string" } },
          "fee_pct": { "type": "number" },
          "min_fee_inr": { "type": ["number", "null"] },
          "max_fee_inr_per_txn": { "type": ["number", "null"] },
          "free_up_to_inr": { "type": ["number", "null"], "description": "Spend below which no fee applies" },
          "per_txn_above_inr": { "type": ["number", "null"] },
          "cumulative_period": { "enum": ["STATEMENT_CYCLE", "CALENDAR_MONTH", "PREVIOUS_CALENDAR_MONTH", null] },
          "thresholds_by_variant": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["variants", "cumulative_above_inr"],
              "properties": {
                "variants": { "$ref": "#/definitions/variant_list" },
                "cumulative_above_inr": { "type": ["number", "null"] }
              }
            }
          },
          "excluded_variants": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" },
          "locator": { "type": "string" }
        }
      }
    },
    "reward_rules": {
      "type": "array",
      "description": "Caps, expiry and redemption restrictions stated in the MITC",
      "items": {
        "type": "object",
        "required": ["rule"],
        "properties": {
          "rule": { "type": "string" },
          "category": { "type": "string" },
          "caps_by_variant": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "variants": { "$ref": "#/definitions/variant_list" },
                "cap": { "type": ["number", "null"] },
                "unit": { "type": "string" }
              }
            }
          },
          "locator": { "type": "string" }
        }
      }
    },
    "fuel_surcharge_waiver": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variants"],
        "properties": {
          "variants": { "$ref": "#/definitions/variant_list" },
          "waiver_pct": { "type": ["number", "null"] },
          "txn_min_inr": { "type": ["number", "null"] },
          "txn_max_inr": { "type": ["number", "null"] },
          "max_waiver_per_cycle_inr": { "type": ["number", "null"] },
          "no_cap": { "type": "boolean" },
          "not_applicable": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "lounge_spend_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variants"],
        "properties": {
          "variants": { "$ref": "#/definitions/variant_list" },
          "domestic_quarterly_spend_gate_inr": { "type": ["number", "null"] },
          "notes": { "type": "string" }
        }
      }
    },
    "emi_policy": {
      "type": "object",
      "properties": {
        "processing_fee_stated": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
