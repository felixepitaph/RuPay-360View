{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CVP catalog v2 (issuer-level, one file per scrape date)",
  "type": "object",
  "required": ["issuer_bank", "retrieved_on", "extraction_method", "cards"],
  "additionalProperties": false,
  "definitions": {
    "stated": { "type": ["string", "null"], "description": "Exactly as the page states it; null = 'not stated on page'" },
    "source": {
      "type": "object",
      "required": ["url", "retrieved_on"],
      "properties": {
        "url": { "type": "string" },
        "retrieved_on": { "type": "string", "format": "date" },
        "content_hash": { "type": ["string", "null"] }
      }
    },
    "earn_rule": {
      "type": "object",
      "required": ["category", "rate_text"],
      "properties": {
        "category": { "type": "string" },
        "rate_text": { "type": "string", "description": "As stated, e.g. '10X (1X = 1 pt per Rs200)'" },
        "points_per_block": { "type": ["number", "null"] },
        "block_inr": { "type": ["number", "null"] },
        "cashback_pct": { "type": ["number", "null"] },
        "cap_text": { "type": ["string", "null"] },
        "gate_text": { "type": ["string", "null"], "description": "Spend tier / milestone / minimum txn" },
        "exclusions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "card": {
      "type": "object",
      "required": ["card_id", "card_name", "source", "fees", "earn_rules", "page_conflicts"],
      "properties": {
        "card_id": { "type": "string" },
        "card_name": { "type": "string" },
        "network": { "type": ["string", "null"], "description": "As stated on page; null if not stated" },
        "backing": { "enum": ["UNSECURED", "FD_BACKED", "NOT_STATED"] },
        "source": { "$ref": "#/definitions/source" },
        "eligibility": { "type": "object" },
        "fees": { "type": "object" },
        "reward_currency": { "type": "object" },
        "earn_rules": { "type": "array", "items": { "$ref": "#/definitions/earn_rule" } },
        "upi": { "type": "object" },
        "travel_bonus": { "type": ["object", "null"] },
        "redemption": { "type": ["object", "null"] },
        "lounge": { "type": "object" },
        "forex": { "type": "object" },
        "welcome_benefits": { "type": "array", "items": { "type": "string" } },
        "milestones": { "type": "array", "items": { "type": "string" } },
        "movie_offer": { "$ref": "#/definitions/stated" },
        "fuel_surcharge_waiver": { "$ref": "#/definitions/stated" },
        "insurance": { "type": "array", "items": { "type": "string" } },
        "golf": { "$ref": "#/definitions/stated" },
        "other_benefits": { "type": "array", "items": { "type": "string" } },
        "page_conflicts": { "type": "array", "items": { "type": "string" }, "description": "Places where the page contradicts itself. MITC wins on fees." },
        "verification_status": { "enum": ["LLM_EXTRACT_UNVERIFIED", "RAW_TEXT_VERIFIED", "HUMAN_VERIFIED"] }
      }
    }
  },
  "properties": {
    "issuer_bank": { "type": "string" },
    "retrieved_on": { "type": "string", "format": "date" },
    "extraction_method": { "type": "string" },
    "not_yet_extracted": { "type": "array", "items": { "type": "string" } },
    "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/card" } }
  }
}
