{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proposition events (dated CVP / MITC changes)",
  "type": "object",
  "required": ["events"],
  "properties": {
    "description": {"type": "string"},
    "events": {"type": "array", "items": {
      "type": "object",
      "required": ["event_id", "issuer_bank", "event_type", "effective_date", "direction", "description", "sources"],
      "properties": {
        "event_id": {"type": "string"},
        "issuer_bank": {"type": "string"},
        "card_ids": {"type": "array", "items": {"type": "string"}},
        "event_type": {"enum": ["CVP_CHANGE", "MITC_CHANGE", "LAUNCH", "DISCONTINUED"]},
        "effective_date": {"type": "string", "format": "date"},
        "direction": {"enum": ["ENHANCEMENT", "DEVALUATION", "NEUTRAL"]},
        "affected_categories": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"},
        "sources": {"type": "array", "minItems": 1}
      }}}
  }
}
